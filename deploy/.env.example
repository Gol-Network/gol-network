# Copy to deploy/.env.production on the host with mode 0600. Never commit a filled copy.
# deploy.sh passes this file to Compose for both interpolation and service environments.

# --- Host and ingress ---------------------------------------------------------------------
DOMAIN=gol.example.com
APP_ORIGIN=https://gol.example.com
POSTGRES_ADMIN_PASSWORD=replace-with-long-random-admin-value
POSTGRES_RUNTIME_PASSWORD=replace-with-separate-long-random-runtime-value

# --- Arc testnet --------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app
# Optional. Shown to an owner whose wallet has no gas; GOL never funds an empty owner wallet.
ARC_FAUCET_URL=
# Optional guard. Startup fails when this is set to anything other than 5042002.
ARC_CHAIN_ID=5042002

# --- The Graph ----------------------------------------------------------------------------
GRAPH_QUERY_URL=
GRAPH_API_KEY=

# --- Privy (owner authentication and owner embedded wallet) -----------------------------
# One canonical application ID is used for authentication, provisioning, the worker, and the
# public app ID handed to the browser at runtime.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
# Privy agent signer (only used when AGENT_SIGNER_PROVIDER=privy). Key-quorum/signer ID that
# owns PRIVY_AUTHORIZATION_PRIVATE_KEY. Configure both or neither.
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# --- Agent signer ----------------------------------------------------------------------------
# privy | aws_kms. aws_kms replaces the Privy agent signer with a non-exportable AWS KMS key.
# Privy still authenticates the owner and owns the owner embedded wallet in both modes.
AGENT_SIGNER_PROVIDER=aws_kms
# Required when AGENT_SIGNER_PROVIDER=aws_kms. The key ARN is operational configuration, not a
# browser value, and is never exposed by any public API. The worker obtains AWS credentials from
# the EC2 instance role over IMDS; no static AWS access keys belong in this file or the containers.
AWS_KMS_SIGNER_KEY_ARN=arn:aws:kms:ap-northeast-1:000000000000:key/00000000-0000-0000-0000-000000000000
AWS_KMS_SIGNER_REGION=ap-northeast-1
# Independently derived EIP-55 checksum address for the KMS public key. The worker re-derives this
# from the key on startup and refuses to run on any mismatch with this value or a linked account.
AWS_KMS_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
# Native-unit (wei) balance below which the worker refuses to sign, and hard transaction ceilings.
AGENT_GAS_LOW_WATERMARK=200000000000000
AGENT_MAX_GAS=400000
AGENT_MAX_FEE_PER_GAS=20000000000
# Optional. Defaults: priority fee ceiling = AGENT_MAX_FEE_PER_GAS; gas margin = 1.25.
AGENT_MAX_PRIORITY_FEE_PER_GAS=3000000000
AGENT_GAS_MARGIN=1.25
# Optional. Default true for aws_kms: the operator funds the shared agent gas reserve and the owner
# is never asked to top it up. Set to false to keep the owner-funded gas step in the UI. The worker
# still refuses to sign below AGENT_GAS_LOW_WATERMARK regardless. Monitor the agent address balance.
AGENT_GAS_MANAGED=true

# --- Model --------------------------------------------------------------------------------
OPENAI_API_KEY=
# Private authentication shared only by the Next.js proxy and the LangGraph service.
GOL_AGENT_SHARED_SECRET=replace-with-long-random-internal-value
GOL_LANGGRAPH_MODEL=gpt-5.5-2026-04-23
AAVE_MCP_URL=https://mcp.aave.com/mcp
AAVE_MCP_DISCOVERY=true
# Optional private Arc testnet market. Leave empty until DeployArcAaveSandbox has been broadcast
# and its independently verified addresses are recorded in deployments/arc-aave-sandbox.json.
ARC_AAVE_POOL_ADDRESS=
ARC_AAVE_ATOKEN_ADDRESS=
ARC_AAVE_VARIABLE_DEBT_TOKEN_ADDRESS=
# Optional Botanary owner-action backend. Kept server-side and proxied through a narrow allowlist.
BOTANARY_API_URL=

# --- Deployed GOL addresses ---------------------------------------------------------------
# Read on the server at runtime and passed to the browser as typed props. No build-time
# NEXT_PUBLIC_* replacement is used, so one image serves any configured deployment.
FACTORY_ADDRESS=
DEMO_ACCOUNT=

# --- Demonstration amounts ----------------------------------------------------------------
GOL_ACCOUNT_TARGET_USDC=100
GOL_AGENT_GAS_TOPUP_USDC=1
GOL_MIN_OWNER_GAS_WEI=1000000000000000
GOL_MIN_AGENT_GAS_WEI=1000000000000000

# --- Operator-only secrets ----------------------------------------------------------------
# These authenticate the developer CLI and the live acceptance runner as a local subject.
# They are not needed by the browser flow. Leave them empty unless an operator is running
# `pnpm demo:acceptance`, the `gol` CLI, or scripts/preflight.ts against this deployment.
GOL_DEV_TOKEN=
GOL_DEV_SUBJECT=
# Operator-only. Base URL and mandate used by the acceptance runner.
GOL_API_URL=
GOL_DEMO_MANDATE_ID=
GOL_DEMO_RECIPIENT_LABEL=
# Operator-only. Opt-in for the Privy policy probe, whose allowed call consumes agent gas.
GOL_POLICY_PROBE=
