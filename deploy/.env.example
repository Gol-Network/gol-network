# Copy to deploy/.env.production on the host with mode 0600. Never commit a filled copy.
# deploy.sh passes this file to Compose for both interpolation and service environments.

# --- Host and ingress ---------------------------------------------------------------------
DOMAIN=gol.example.com
APP_ORIGIN=https://gol.example.com
POSTGRES_ADMIN_PASSWORD=replace-with-long-random-admin-value
POSTGRES_RUNTIME_PASSWORD=replace-with-separate-long-random-runtime-value

# --- Arc testnet --------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app
# Optional. Shown to an owner whose wallet has no gas; GOL never funds an empty owner wallet.
ARC_FAUCET_URL=
# Optional guard. Startup fails when this is set to anything other than 5042002.
ARC_CHAIN_ID=5042002

# --- The Graph ----------------------------------------------------------------------------
GRAPH_QUERY_URL=
GRAPH_API_KEY=

# --- Privy --------------------------------------------------------------------------------
# One canonical application ID is used for authentication, provisioning, the worker, and the
# public app ID handed to the browser at runtime.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
# Key-quorum/signer ID that owns PRIVY_AUTHORIZATION_PRIVATE_KEY. Configure both or neither.
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# --- Model --------------------------------------------------------------------------------
OPENAI_API_KEY=

# --- Deployed GOL addresses ---------------------------------------------------------------
# Read on the server at runtime and passed to the browser as typed props. No build-time
# NEXT_PUBLIC_* replacement is used, so one image serves any configured deployment.
FACTORY_ADDRESS=
DEMO_ACCOUNT=

# --- Demonstration amounts ----------------------------------------------------------------
GOL_RECIPIENT_LABEL=Design contractor
GOL_ACCOUNT_TARGET_USDC=100
GOL_AGENT_GAS_TOPUP_USDC=1
GOL_MIN_OWNER_GAS_WEI=1000000000000000
GOL_MIN_AGENT_GAS_WEI=1000000000000000

# --- Operator-only secrets ----------------------------------------------------------------
# These authenticate the developer CLI and the live acceptance runner as a local subject.
# They are not needed by the browser flow. Leave them empty unless an operator is running
# `pnpm demo:acceptance`, the `gol` CLI, or scripts/preflight.ts against this deployment.
GOL_DEV_TOKEN=
GOL_DEV_SUBJECT=
# Operator-only. Base URL and mandate used by the acceptance runner.
GOL_API_URL=
GOL_DEMO_MANDATE_ID=
GOL_DEMO_RECIPIENT_LABEL=
# Operator-only. Opt-in for the Privy policy probe, whose allowed call consumes agent gas.
GOL_POLICY_PROBE=
