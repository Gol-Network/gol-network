{
  "name": "@gol/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gol": "./src/cli.ts"
  },
  "exports": {
    "./db": {
      "types": "./src/db/journal.ts",
      "default": "./dist/db/journal.js"
    },
    "./query": {
      "types": "./src/query/index.ts",
      "default": "./dist/query/index.js"
    },
    "./model": {
      "types": "./src/model/index.ts",
      "default": "./dist/model/index.js"
    },
    "./privy": {
      "types": "./src/privy/policy.ts",
      "default": "./dist/privy/policy.js"
    },
    "./instruction": {
      "types": "./src/payment/parse-instruction.ts",
      "default": "./dist/payment/parse-instruction.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "worker": "tsx src/payment/worker-entry.ts",
    "probe": "tsx src/tools/policy-probe.ts"
  },
  "dependencies": {
    "@gol/protocol": "workspace:*",
    "@privy-io/node": "0.34.0",
    "commander": "15.0.0",
    "openai": "7.10.0",
    "pg": "8.23.0",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/pg": "8.15.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
